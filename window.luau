local registered = false

local function install()
	if registered then
		return
	end
	registered = true
	for _, e in ipairs(entries) do
		local action_id, title, group = e[1], e[2], e[3]
		local id = "zh-" .. string.gsub(action_id, "[:%.]", "-")
		tern.command({
			id = id,
			title = title,
			group = group,
			run = function(cx)
				local ok, err = pcall(function()
					cx:action(action_id)
				end)
				if not ok then
					cx:toast("warn", "此命令当前不可用", tostring(err))
				end
			end,
		})
	end
end

-- 加载即注册（窗口半边），并保证每个新窗口都有一份。
install()
tern.on("window_start", function()
	install()
end)
